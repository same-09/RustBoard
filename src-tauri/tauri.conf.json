{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rustboard",
  "version": "1.0.0",
  "identifier": "com.rustboard.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Rustboard",
        "width": 760,
        "height": 520,
        "minWidth": 560,
        "minHeight": 340
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
